# Microsoft Azure Entra ID App Registration
AZURE_CLIENT_ID=your-client-id-here
AZURE_TENANT_ID=your-tenant-id-here
# Optional: Only needed for confidential client flow
AZURE_CLIENT_SECRET=

# OneDrive path to the xlsx file (relative to root of OneDrive)
# Each user sets their own path — configured during first-run setup
# Example (mock/dev): Documents/Arnold_project_trial
# Example (production): Sales Folder/Architecture Folder/client_tracking.xlsx
ONEDRIVE_FILE_PATH=

# App settings
APP_HOST=127.0.0.1
APP_PORT=8000
FOLLOW_UP_DAYS=7
MAX_FOLLOW_UPS=2
SEND_RATE_LIMIT_DELAY=2.0
